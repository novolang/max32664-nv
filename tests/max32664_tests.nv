@test
fn test_the_samples_waiting_are_asked_of_the_hub() [io, hw]
    let h = hub()
    let d = dut(h)
    test.assert(max32664.samples_available(d) == Some(15))
    log_is(h, [1, 0x12, 0x00, -1, 2, 2, -1])
    h.st.insert(4, 0)
    test.assert(max32664.samples_available(d) == None)

@test
fn test_the_counts_are_big_endian() [io, hw]
    var b: DevBytes = Vec.new()
    for x in [0x01, 0x02, 0x03, 0x04]
        let _ = b.push(x as u8)
    test.assert_eq(max32664.count24(b, 0), 0x010203)
    test.assert_eq(max32664.count24(b, 1), 0x020304)
    test.assert_eq(max32664.word16(b, 2), 0x0304)

@test
fn test_the_report_and_the_sample_decode_from_bytes_at_an_offset() [io, hw]
    var b: DevBytes = Vec.new()
    for x in trace_sample()
        let _ = b.push(x as u8)
    let r = max32664.report_of(b, 12, false)
    test.assert_eq(r.heart_rate_x10, 630)
    test.assert_eq(r.confidence, 99)
    test.assert_eq(r.spo2_x10, 996)
    test.assert_eq(r.state, 3)
    let s = max32664.sample_of(b, cfg_of(3, 1))
    test.assert_eq(s.led1, 223811)
    test.assert_eq(s.led4, 11797)
    test.assert(s.report != None)

@test
fn test_the_trace_sample_decodes_as_the_guide_describes_it() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x01, trace_sample())
    let d = dut(h)
    match max32664.sample_read(d, cfg_of(3, 1))
        Some(s) =>
            test.assert_eq(s.led1, 223811)
            test.assert_eq(s.led2, 197778)
            test.assert_eq(s.led3, 0)
            test.assert_eq(s.led4, 11797)
            match s.report
                Some(r) =>
                    test.assert_eq(r.heart_rate_x10, 630)
                    test.assert_eq(r.confidence, 99)
                    test.assert_eq(r.spo2_x10, 996)
                    test.assert_eq(r.state, 3)
                    test.assert_eq(r.r_x10, 0)
                    test.assert_eq(r.ext_state, 0)
                None    => test.assert(false)
        None    => test.assert(false)
    log_is(h, [1, 0x12, 0x01, -1, 2, 19, -1])

@test
fn test_an_output_of_the_algorithm_only_starts_the_report_at_byte_0() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x01, [0x02, 0x76, 0x63, 0x03, 0xE4, 0x03])
    let d = dut(h)
    match max32664.report_read(d, cfg_of(2, 1))
        Some(r) =>
            test.assert_eq(r.heart_rate_x10, 630)
            test.assert_eq(r.spo2_x10, 996)
        None    => test.assert(false)
    log_is(h, [1, 0x12, 0x01, -1, 2, 7, -1])
    match max32664.sample_read(d, cfg_of(2, 1))
        Some(s) => test.assert_eq(s.led1, 0)
        None    => test.assert(false)

@test
fn test_an_output_of_the_sensor_only_has_no_report() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x01, [0x00, 0x00, 0x01, 0x00, 0x00, 0x02, 0x00, 0x00, 0x03, 0x00, 0x00, 0x04])
    let d = dut(h)
    match max32664.sample_read(d, cfg_of(1, 0))
        Some(s) =>
            test.assert_eq(s.led1, 1)
            test.assert_eq(s.led2, 2)
            test.assert_eq(s.led3, 3)
            test.assert_eq(s.led4, 4)
            test.assert(s.report == None)
        None    => test.assert(false)
    log_clear(h)
    test.assert(max32664.report_read(d, cfg_of(1, 0)) == None)
    test.assert_eq(at(h.st, 99), 0)

@test
fn test_the_extended_report_adds_the_r_value_and_the_extended_state() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x01, [0x02, 0x76, 0x63, 0x03, 0xE4, 0x03, 0x00, 0x7B, 0x05, 0x00, 0x00])
    match max32664.report_read(dut(h), cfg_of(2, 2))
        Some(r) =>
            test.assert_eq(r.heart_rate_x10, 630)
            test.assert_eq(r.r_x10, 123)
            test.assert_eq(r.ext_state, 5)
        None    => test.assert(false)
    log_is(h, [1, 0x12, 0x01, -1, 2, 12, -1])

@test
fn test_a_failed_sample_read_answers_nothing() [io, hw]
    let h = hub()
    h.st.insert(4, 0)
    test.assert(max32664.sample_read(dut(h), cfg_of(3, 1)) == None)
    test.assert(max32664.report_read(dut(h), cfg_of(3, 1)) == None)

@test
fn test_a_report_is_good_when_a_finger_is_found_with_enough_confidence() [io, hw]
    let good = Max32664Report { heart_rate_x10: 630,
        confidence: 99,
        spo2_x10: 996,
        state: 3,
        r_x10: 0,
        ext_state: 0 }
    test.assert(max32664.report_good(good, 90))
    test.assert(max32664.report_good(good, 99))
    test.assert(not max32664.report_good(good, 100))
    let none = Max32664Report { heart_rate_x10: 0,
        confidence: 99,
        spo2_x10: 0,
        state: 0,
        r_x10: 0,
        ext_state: 0 }
    test.assert(not max32664.report_good(none, 0))
    let other = Max32664Report { heart_rate_x10: 0,
        confidence: 99,
        spo2_x10: 0,
        state: 2,
        r_x10: 0,
        ext_state: 0 }
    test.assert(not max32664.report_good(other, 0))

// ── The PPG samples ──────────────────────────────────────────────────

@test
fn test_the_fifo_is_drained_one_sample_at_a_time_oldest_first() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x00, [3])
    answer(h, 0x12, 0x01, trace_sample())
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(max32664.drain(dut(h), cfg_of(3, 1), var out), 3)
    test.assert_eq(out.len(), 3)
    for i in 0..3
        test.assert_eq(out[i].ir, 223811)
        test.assert_eq(out[i].red, 197778)
        test.assert(out[i].green == Some(0))
    // The newest is stamped with the tick, the older ones 10 ms apart before it.
    test.assert_eq(out[1].at_us - out[0].at_us, 10000)
    test.assert_eq(out[2].at_us - out[1].at_us, 10000)
    // The count, then three reads of 19 bytes.
    test.assert_eq(at(h.st, 1), 2 + 6)

@test
fn test_a_drain_of_an_empty_fifo_or_of_an_output_without_sensor_data_is_zero() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x00, [0])
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(max32664.drain(dut(h), cfg_of(3, 1), var out), 0)
    test.assert_eq(at(h.st, 1), 2)
    let h2 = hub()
    test.assert_eq(max32664.drain(dut(h2), cfg_of(2, 1), var out), 0)
    test.assert_eq(at(h2.st, 1), 0)

@test
fn test_a_drain_reads_at_most_32_samples() [io, hw]
    let h = hub()
    answer(h, 0x12, 0x00, [40])
    answer(h, 0x12, 0x01, trace_sample())
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(max32664.drain(dut(h), cfg_of(3, 1), var out), 32)
    test.assert_eq(out.len(), 32)

@test
fn test_a_drain_fails_when_the_count_or_a_sample_cannot_be_read() [io, hw]
    let h = hub()
    h.st.insert(4, 0)
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(max32664.drain(dut(h), cfg_of(3, 1), var out), -1)
    let h2 = hub()
    answer(h2, 0x12, 0x00, [3])
    answer(h2, 0x12, 0x01, trace_sample())
    // The count is transactions 1 and 2; the second sample's write is the 5th.
    h2.st.insert(2, 5)
    test.assert_eq(max32664.drain(dut(h2), cfg_of(3, 1), var out), -1)
    test.assert_eq(out.len(), 0)

@test
fn test_the_overflow_flag_of_the_status_is_the_lost_count() [io, hw]
    let h = hub()
    let d = dut(h)
    test.assert_eq(max32664.lost(d), 0)
    answer(h, 0x00, 0x00, [0x98])
    test.assert_eq(max32664.lost(d), 1)
    h.st.insert(4, 0)
    test.assert_eq(max32664.lost(d), 0)

@test
fn test_the_rate_is_the_one_rate_of_the_firmware_once_sampling_started() [io, hw]
    let h = hub()
    test.assert_eq(max32664.rate_set(dut(h), max32664.config_default()), 100)
    test.assert_eq(at(h.st, 1), 10)
    h.st.insert(2, 13)
    test.assert_eq(max32664.rate_set(dut(h), max32664.config_default()), 0)

@test
fn test_the_leds_have_the_registers_and_the_steps_of_the_max30101() [io, hw]
    test.assert_eq(max32664.led_reg(PpgLed.PpgRed), 0x0C)
    test.assert_eq(max32664.led_reg(PpgLed.PpgIr), 0x0D)
    test.assert_eq(max32664.led_reg(PpgLed.PpgGreen), 0x0E)
    test.assert_eq(max32664.led_code_of_ma(0), 0)
    test.assert_eq(max32664.led_code_of_ma(-3), 0)
    // The guide's trace sets 0x32 for the LEDs: 10 mA.
    test.assert_eq(max32664.led_code_of_ma(10), 0x32)
    test.assert_eq(max32664.led_code_of_ma(51), 255)
    test.assert_eq(max32664.led_code_of_ma(100), 255)
    test.assert_eq(max32664.ma_of_led_code(0x32), 10)
    test.assert_eq(max32664.ma_of_led_code(255), 51)
    let h = hub()
    test.assert_eq(max32664.led_set(dut(h), PpgLed.PpgIr, 10), 10)
    log_is(h, [1, 0x40, 0x03, 0x0D, 0x32, -1, 2, 1, -1])
    h.err.insert(0x4003, 4)
    test.assert_eq(max32664.led_set(dut(h), PpgLed.PpgRed, 10), 0)

// ── The type over the host's board handles ───────────────────────────
//
// The host's I2C bus is absent hardware: every transfer is refused, so each
// method answers its "no hub" value.  This runs the lines of the type that
// forward to the functions above.

fn absent(w: DeviceWiring) -> Max32664
    Max32664.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, w, max32664.config_default())

@test
fn test_the_type_over_absent_hardware() [io, hw]
    let p = absent(wiring())
    test.assert(not p.begin())
    test.assert(not p.begin_bootloader())
    test.assert(p.mode() == None)
    test.assert(p.status() == None)
    test.assert(p.fifo_count() == None)
    test.assert(p.report_now() == None)
    test.assert(p.sample_now() == None)
    test.assert(p.hub_version() == None)
    test.assert(p.algo_version() == None)
    test.assert(p.bootloader_version() == None)
    test.assert(p.bootloader_page_size() == None)
    test.assert(not p.exit_bootloader())
    test.assert(not p.reset())
    test.assert(not p.stop())
    test.assert(not p.set_agc(true))
    test.assert(p.afe_reg(0x07) == None)
    test.assert(not p.set_afe_reg(0x0D, 0x32))
    test.assert_eq(p.mfio(), 0)
    test.assert_eq(p.ppg_set_rate_hz(100), 0)
    test.assert_eq(p.ppg_set_led_ma(PpgLed.PpgRed, 6), 0)
    test.assert_eq(p.ppg_lost(), 0)
    var out: Vec[PpgSample; 32] = Vec.new()
    test.assert_eq(p.ppg_drain(var out), -1)
    test.assert(p.device_id() == None)

@test
fn test_the_port_of_the_type_over_absent_hardware() [io, hw]
    let p = absent(wiring())
    var dst: DevBytes = Vec.new()
    test.assert(not p.read_resp(1, var dst))
    test.assert(p.now_us() >= 0)
    test.assert(p.now_ms() >= 0)

@test
fn test_the_type_without_pins_over_absent_hardware() [io, hw]
    let p = absent(wiring_no_pins())
    test.assert(not p.begin())
    test.assert_eq(p.mfio(), -1)

// A function written against the trait alone, called on a `let`.
fn drain_all<R: HeartRate>(r: R) -> Int [hw]
    var out: Vec[PpgSample; 32] = Vec.new()
    r.ppg_drain(var out)

@test
fn test_a_function_over_the_trait_reads_the_hub_through_a_plain_parameter() [io, hw]
    test.assert_eq(drain_all(absent(wiring())), -1)
